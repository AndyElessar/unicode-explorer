<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TUnit test projects are executables running on Microsoft.Testing.Platform -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosts the published site under /unicode-explorer/ like GitHub Pages -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Playwright" />
  </ItemGroup>

</Project>
