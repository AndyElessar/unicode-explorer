@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject UnicodeDatabase Db
@inject PreferenceService Prefs

<div class="app">
    <header class="app-header">
        <button class="icon-button menu-button" aria-label="Show blocks" aria-expanded="@(_drawerOpen ? "true" : "false")"
                @onclick="() => _drawerOpen = !_drawerOpen">☰</button>
        <a class="app-title" href="">Unicode Explorer</a>
        <SearchBox />
        <button class="icon-button" aria-label="Display settings" title="Display settings"
                aria-expanded="@(_settingsOpen ? "true" : "false")" @onclick="() => _settingsOpen = !_settingsOpen">Aa</button>
        @* Shows the current setting; each click moves to the next one (System → Light → Dark) *@
        <button class="icon-button theme-button" data-theme-setting="@Prefs.Theme" @onclick="Prefs.CycleTheme"
                aria-label="@ThemeTitle" title="@ThemeTitle">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                @switch (Prefs.Theme)
                {
                    case "light":
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                        break;
                    case "dark":
                        <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
                        break;
                    default:
                        <rect x="3" y="4" width="18" height="12" rx="2" />
                        <path d="M8 20h8M12 16v4" />
                        break;
                }
            </svg>
        </button>
    </header>

    @if (_settingsOpen)
    {
        @* Transparent layer under the panel: a click anywhere else closes it *@
        <div class="settings-backdrop" @onclick="() => _settingsOpen = false"></div>
        <DisplaySettings OnClose="() => _settingsOpen = false" />
    }

    <div class="app-body">
        <nav class="sidebar @(_drawerOpen ? "open" : "")" aria-label="Unicode blocks">
            <BlockList />
        </nav>
        @if (_drawerOpen)
        {
            <div class="backdrop" @onclick="() => _drawerOpen = false"></div>
        }
        <main class="app-main">
            @Body
        </main>
    </div>

    <footer class="app-footer">
        Unicode @Db.UnicodeVersion data ©
        <a href="https://www.unicode.org/" target="_blank" rel="noopener">Unicode, Inc.</a>
        (<a href="data/LICENSE-UNICODE.txt" target="_blank">license</a>)
    </footer>

    <Toast />
</div>

@code {
    private bool _drawerOpen;
    private bool _settingsOpen;

    private string ThemeTitle =>
        $"Theme: {ThemeRules.Label(Prefs.Theme)} (switch to {ThemeRules.Label(ThemeRules.Next(Prefs.Theme))})";

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _drawerOpen = false;
        StateHasChanged();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
